{
  "name": "cursor-ai-sdk-provider",
  "version": "0.0.1",
  "description": "Community AI SDK provider for the Cursor SDK.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "example:basic": "node --import ./examples/load-env.mjs --import tsx examples/basic-usage.ts",
    "example:check": "node --import ./examples/load-env.mjs --import tsx examples/check-setup.ts",
    "example:cloud": "node --import ./examples/load-env.mjs --import tsx examples/cloud-agent.ts",
    "example:config": "node --import ./examples/load-env.mjs --import tsx examples/custom-config.ts",
    "example:images": "node --import ./examples/load-env.mjs --import tsx examples/images.ts",
    "example:limitations": "node --import ./examples/load-env.mjs --import tsx examples/limitations.ts",
    "example:mcp-filesystem": "node --import ./examples/load-env.mjs --import tsx examples/mcp-filesystem.ts",
    "example:streaming": "node --import ./examples/load-env.mjs --import tsx examples/streaming.ts",
    "example:tool-streaming": "node --import ./examples/load-env.mjs --import tsx examples/tool-streaming.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-sdk",
    "cursor",
    "provider",
    "agents"
  ],
  "dependencies": {
    "@ai-sdk/provider": "^3.0.9",
    "@ai-sdk/provider-utils": "^4.0.24",
    "@cursor/sdk": "^1.0.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "ai": "^6.0.170",
    "dotenv": "^17.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
